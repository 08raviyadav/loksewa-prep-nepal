# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing — NEVER commit these. The release keystore lives only on
# the maintainer's machine and as the ANDROID_KEYSTORE_BASE64 GitHub secret.
*.jks
*.keystore
*.p12
android/key.properties
android/local.properties

# Firebase config (see FIREBASE_SETUP.md) — injected as secrets in CI.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Build-time data copies (copied from ../data/ by CI / local builds — the
# web repo's data/ is the single source of truth; see README.md).
# question_index.json is Flutter-only and IS committed.
assets/data/*.json
!assets/data/question_index.json
assets/data/questions/
assets/data/courses/

# Generated launcher icons + splash art (regenerated by
# tools/gen_launcher_icon.py at build time — binaries are not committed).
android/app/src/main/res/mipmap-*/ic_launcher.png
android/app/src/main/res/drawable-*/ic_launcher_foreground.png
android/app/src/main/res/drawable-*/splash.png
android/app/src/main/res/drawable/background.png
android/app/src/main/res/drawable-v21/background.png

# Gradle wrapper jar (binary; CI downloads it — see flutter-release.yml).
android/gradle/wrapper/gradle-wrapper.jar
