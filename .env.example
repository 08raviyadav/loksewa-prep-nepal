# Outrank — backend env vars (example only, never real values)
# Copy to .env.local for local dev (git-ignored). On Vercel, set these in
# the dashboard (Project -> Settings -> Environment Variables) — do NOT
# commit a real .env file. See docs/BACKEND_SETUP.md.

# Added AUTOMATICALLY by Vercel when you create a Postgres database under
# Storage and connect it to this project. You do not type this in by hand.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Invent this yourself: a long random string, e.g. from `openssl rand -hex 32`.
# It is the only key to the admin report queue (GET/PATCH/DELETE /api/report).
# The maintainer types it once per browser tab in the Review view; it is
# kept in sessionStorage only and never saved on the device or in the repo.
ADMIN_TOKEN=choose-a-long-random-token-here
